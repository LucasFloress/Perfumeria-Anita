@using PerfumeriaAnita.Services
@using PerfumeriaAnita.Models
@inject AppConfigState ConfigState
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@implements IDisposable

<aside class="sidebar" style="--color-principal: @ConfigState.ColorPrincipal; display: flex; flex-direction: column;">
    <div class="logo">
        @if (!string.IsNullOrEmpty(ConfigState.LogoBase64))
        {
            <!-- Logo personalizado subido desde configuraciones -->
            <img src="@ConfigState.LogoBase64"
                 alt="Logo @ConfigState.NombreTienda"
                 class="logo-img" />
        }
        else
        {
            <!-- Fallback: emoji + nombre cuando no hay logo -->
            <span class="logo-emoji">🌸</span>
        }
        <div class="logo-texto">
            <span class="logo-nombre">@ConfigState.NombreTienda</span>
            @if (!string.IsNullOrWhiteSpace(ConfigState.Eslogan))
            {
                <span class="logo-eslogan">@ConfigState.Eslogan</span>
            }
        </div>
    </div>

    <nav class="nav-menu">
        <a href="/dashboard"       class="nav-item">Panel Principal</a>
        <a href="/inventario"      class="nav-item">Inventario</a>
        <a href="/ventas"          class="nav-item">Ventas</a>
        <a href="/configuraciones" class="nav-item">Configuración</a>
    </nav>

    @if (AuthService.IsAuthenticated)
    {
        <div style="margin-top: auto; padding: 20px 10px 0; border-top: 1px solid #f1f5f9; display: flex; flex-direction: column; gap: 8px;">
            <div style="display: flex; align-items: center; gap: 10px; padding: 0 10px;">
                <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--color-principal, #D4537E); color: white; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 14px; flex-shrink: 0; text-transform: uppercase;">
                    @(AuthService.UsuarioActual?.Nombre?.Length > 0 ? AuthService.UsuarioActual.Nombre[0].ToString() : "?")
                </div>
                <div style="display: flex; flex-direction: column; min-width: 0;">
                    <span style="font-size: 13px; font-weight: 600; color: #0f172a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@AuthService.UsuarioActual?.Nombre</span>
                    <span style="font-size: 11px; color: #64748b; text-transform: capitalize;">@AuthService.UsuarioActual?.Rol</span>
                </div>
            </div>
            <button @onclick="HandleLogout" class="nav-item" style="border: none; background: transparent; text-align: left; cursor: pointer; width: 100%; display: flex; align-items: center; gap: 8px; color: #e11d48; padding: 9px 12px; border-radius: 8px; font-size: 13.5px; font-weight: 500;">
                <span class="material-symbols-outlined" style="font-size: 18px; vertical-align: middle;">logout</span>
                Cerrar Sesión
            </button>
        </div>
    }
</aside>

@code {
    protected override void OnInitialized()
    {
        // Suscribirse al evento: cuando cambien configuraciones, re-renderizar
        ConfigState.OnChange += OnConfigChanged;
    }

    private void HandleLogout()
    {
        AuthService.Logout();
        NavigationManager.NavigateTo("/");
    }

    private void OnConfigChanged()
    {
        // InvokeAsync porque el evento puede venir de otro hilo
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        // Desuscribirse para evitar memory leaks
        ConfigState.OnChange -= OnConfigChanged;
    }
}