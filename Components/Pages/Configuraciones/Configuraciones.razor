    private async Task GuardarSeguridad()
    {
        _mensajeSeguridad = null;
        _mensajeSeguridadError = null;

        if (string.IsNullOrWhiteSpace(_nuevoNombreUsuario))
        {
            _mensajeSeguridadError = "❌ El nombre de usuario no puede estar vacío.";
            return;
        }

        if (AuthService.UsuarioActual == null)
        {
            _mensajeSeguridadError = "❌ No hay un usuario autenticado.";
            return;
        }

        // Si ingresaron contraseña, validar longitud y coincidencia
        if (!string.IsNullOrEmpty(_nuevaContraseña))
        {
            if (_nuevaContraseña.Length < 6)
            {
                _mensajeSeguridadError = "❌ La contraseña debe tener al menos 6 caracteres.";
                return;
            }

            if (_nuevaContraseña != _confirmarContraseña)
            {
                _mensajeSeguridadError = "❌ Las contraseñas no coinciden.";
                return;
            }
        }

        try
        {
            // Validar que el nombre de usuario no esté duplicado
            var nombreExiste = await Db.Usuarios.AnyAsync(u => u.Id != AuthService.UsuarioActual.Id && u.Nombre.ToLower() == _nuevoNombreUsuario.ToLower());
            if (nombreExiste)
            {
                _mensajeSeguridadError = "❌ El nombre de usuario ya está en uso.";
                return;
            }

            // Buscar en la BD y actualizar
            var usuarioDb = await Db.Usuarios.FindAsync(AuthService.UsuarioActual.Id);
            if (usuarioDb != null)
            {
                usuarioDb.Nombre = _nuevoNombreUsuario;
                if (!string.IsNullOrEmpty(_nuevaContraseña))
                {
                    usuarioDb.Contraseña = _nuevaContraseña;
                }
                
                await Db.SaveChangesAsync();
                
                // Actualizar el estado de sesión actual
                AuthService.Login(usuarioDb);

                _ultimoGuardado = DateTime.Now.ToString("dd/MM/yyyy HH:mm");
                _mensajeSeguridad = "✅ Credenciales actualizadas correctamente.";
                
                // Limpiar campos de contraseña
                _nuevaContraseña = "";
                _confirmarContraseña = "";

                StateHasChanged();
                await Task.Delay(2500);
                _mensajeSeguridad = null;
                StateHasChanged();
            }
            else
            {
                _mensajeSeguridadError = "❌ No se encontró el usuario en la base de datos.";
            }
        }
        catch (Exception ex)
        {
            _mensajeSeguridadError = $"❌ Error al guardar: {ex.Message}";
            Console.WriteLine(ex);
        }
    }

