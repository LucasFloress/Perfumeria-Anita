@page "/configuraciones"
@rendermode InteractiveServer
@using PerfumeriaAnita.Models
@using PerfumeriaAnita.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@inject IConfigService ConfigService
@inject AppConfigState ConfigState
@inject AuthService AuthService
@inject PerfumeriaAnita.Data.AppDbContext Db

<div class="cfg-page">

    <div class="cfg-header">
        <h1 class="cfg-title">Configuración</h1>
        <p class="cfg-sub">Personalizá tu perfumería</p>
    </div>

    <div class="cfg-tabs">
        <button class="cfg-tab @(TabActivo == "apariencia" ? "cfg-tab-active" : "")"
                style="@(TabActivo == "apariencia" ? $"color:{ColorPrincipal};border-bottom-color:{ColorPrincipal}" : "")"
                @onclick='() => TabActivo = "apariencia"'>
            Apariencia
        </button>
        <button class="cfg-tab @(TabActivo == "horarios" ? "cfg-tab-active" : "")"
                style="@(TabActivo == "horarios" ? $"color:{ColorPrincipal};border-bottom-color:{ColorPrincipal}" : "")"
                @onclick='() => TabActivo = "horarios"'>
            Horarios
        </button>
        <button class="cfg-tab @(TabActivo == "notificaciones" ? "cfg-tab-active" : "")"
                style="@(TabActivo == "notificaciones" ? $"color:{ColorPrincipal};border-bottom-color:{ColorPrincipal}" : "")"
                @onclick='() => TabActivo = "notificaciones"'>
            Notificaciones
        </button>
        <button class="cfg-tab @(TabActivo == "general" ? "cfg-tab-active" : "")"
                style="@(TabActivo == "general" ? $"color:{ColorPrincipal};border-bottom-color:{ColorPrincipal}" : "")"
                @onclick='() => TabActivo = "general"'>
            General
        </button>
        <button class="cfg-tab @(TabActivo == "venta" ? "cfg-tab-active" : "")"
                style="@(TabActivo == "venta" ? $"color:{ColorPrincipal};border-bottom-color:{ColorPrincipal}" : "")"
                @onclick='() => TabActivo = "venta"'>
            Venta
        </button>
        <button class="cfg-tab @(TabActivo == "seguridad" ? "cfg-tab-active" : "")"
                style="@(TabActivo == "seguridad" ? $"color:{ColorPrincipal};border-bottom-color:{ColorPrincipal}" : "")"
                @onclick='() => TabActivo = "seguridad"'>
            Seguridad
        </button>
    </div>

    @if (_cargando)
    {
        <div class="cfg-loading">Cargando configuraciones...</div>
    }
    else
    {
        <div class="cfg-body">

            @* ══ APARIENCIA ══════════════════════════════════════════════ *@
            @if (TabActivo == "apariencia")
            {
                @if (_mensajeAp is not null)
                {
                    <div class="cfg-toast" style="border-color:@ColorPrincipal;background:@(ColorPrincipal + "18");color:@ColorPrincipal">
                        @_mensajeAp
                    </div>
                }

                @* ── Card: Nombre y eslogan ── *@
                <div class="cfg-card">
                    <div class="cfg-card-head">
                        <div>
                            <div class="cfg-card-title">Nombre de la tienda</div>
                            <div class="cfg-card-sub">Se muestra en el menú lateral y notificaciones</div>
                        </div>
                        <button class="cfg-btn-save" style="background:@ColorPrincipal" @onclick="GuardarApariencia">
                            Guardar
                        </button>
                    </div>
                    <div class="cfg-row">
                        <div><div class="cfg-label">Nombre</div></div>
                        <input type="text" @bind="_nombreTienda" @bind:event="oninput" class="cfg-input" />
                    </div>
                    <div class="cfg-row">
                        <div><div class="cfg-label">Eslogan</div><div class="cfg-desc">Opcional — aparece debajo del nombre</div></div>
                        <input type="text" @bind="_eslogan" class="cfg-input" />
                    </div>
                </div>

                @* ── Card: Logo ── *@
                <div class="cfg-card">
                    <div class="cfg-card-head">
                        <div>
                            <div class="cfg-card-title">Logo de la tienda</div>
                            <div class="cfg-card-sub">Se muestra en el menú lateral. PNG, JPG o SVG. Máx. 1 MB.</div>
                        </div>
                        <button class="cfg-btn-save" style="background:@ColorPrincipal" @onclick="GuardarApariencia">
                            Guardar
                        </button>
                    </div>
                    <div class="cfg-row" style="flex-direction:column; align-items:flex-start; gap:14px">

                        @* Preview actual *@
                        <div style="display:flex; align-items:center; gap:16px;">
                            @if (!string.IsNullOrEmpty(_logoBase64))
                            {
                                <img src="@_logoBase64"
                                     alt="Logo actual"
                                     style="height:56px; width:56px; object-fit:contain; border-radius:8px; border:1px solid #e2e8f0;" />
                            }
                            else
                            {
                                <div style="height:56px; width:56px; border-radius:8px; border:1.5px dashed #e2e8f0;
                                            display:flex; align-items:center; justify-content:center; font-size:24px;">
                                    🌸
                                </div>
                            }
                            <div>
                                <div class="cfg-label">@(_logoBase64 is null ? "Sin logo cargado" : "Logo actual")</div>
                                <div class="cfg-desc">Se muestra en el menú lateral de la app</div>
                            </div>
                        </div>

                        @* Input de archivo *@
                        <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                            <InputFile OnChange="OnLogoSeleccionado"
                                       accept=".png,.jpg,.jpeg,.svg,.webp"
                                       style="font-size:13px; color:#64748b;" />
                            @if (!string.IsNullOrEmpty(_logoBase64))
                            {
                                <button class="cfg-btn-save"
                                        style="background:#e2e8f0; color:#64748b; font-weight:500;"
                                        @onclick="EliminarLogo">
                                    Quitar logo
                                </button>
                            }
                        </div>

                        @if (_errorLogo is not null)
                        {
                            <div style="font-size:12px; color:#e24b4a;">@_errorLogo</div>
                        }
                    </div>
                </div>

                @* ── Card: Color principal ── *@
                <div class="cfg-card">
                    <div class="cfg-card-head">
                        <div>
                            <div class="cfg-card-title">Color principal</div>
                            <div class="cfg-card-sub">Se aplica en botones, badges y acentos de toda la app</div>
                        </div>
                        <button class="cfg-btn-save" style="background:@ColorPrincipal" @onclick="GuardarApariencia">
                            Guardar
                        </button>
                    </div>
                    <div class="cfg-row" style="flex-direction:column; align-items:flex-start; gap:14px">
                        <div class="cfg-label">Colores predefinidos</div>
                        <div class="cfg-swatch-row">
                            @foreach (var c in _coloresPredefinidos)
                            {
                                <div class="cfg-swatch @(ColorPrincipal == c ? "cfg-swatch-sel" : "")"
                                     style="background:@c"
                                     @onclick="() => AplicarColorPreview(c)">
                                </div>
                            }
                        </div>
                        <div style="display:flex; align-items:center; gap:10px;">
                            <span class="cfg-desc">Hex personalizado:</span>
                            <input type="color"
                                   value="@ColorPrincipal"
                                   @oninput="OnColorPickerChange"
                                   style="width:36px; height:36px; border:none; border-radius:6px; cursor:pointer; padding:2px;" />
                            <input type="text"
                                   @bind="ColorPrincipal"
                                   @bind:event="oninput"
                                   class="cfg-input"
                                   style="width:110px"
                                   placeholder="#D4537E" />
                            <div style="width:26px; height:26px; border-radius:50%; border:1px solid #e2e8f0; background:@ColorPrincipal"></div>
                        </div>

                        @* Preview en vivo de cómo queda el color *@
                        <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                            <button style="background:@ColorPrincipal; color:white; border:none; border-radius:8px;
                                           padding:7px 16px; font-size:13px; font-weight:600; cursor:default;">
                                Botón ejemplo
                            </button>
                            <span style="background:@(ColorPrincipal + "20"); color:@ColorPrincipal;
                                         border-radius:6px; padding:3px 10px; font-size:12px; font-weight:600;">
                                BADGE
                            </span>
                            <div style="height:4px; border-radius:2px; width:100px; background:@ColorPrincipal;"></div>
                        </div>
                    </div>
                </div>
            }

            @* ══ HORARIOS ═════════════════════════════════════════════════ *@
            @if (TabActivo == "horarios")
            {
                @if (_mensajeH is not null)
                {
                    <div class="cfg-toast" style="border-color:@ColorPrincipal;background:@(ColorPrincipal + "18");color:@ColorPrincipal">
                        @_mensajeH
                    </div>
                }

                <div class="cfg-card">
                    <div class="cfg-card-head">
                        <div><div class="cfg-card-title">Sistema horario</div></div>
                        <button class="cfg-btn-save" style="background:@ColorPrincipal" @onclick="GuardarHorarios">Guardar</button>
                    </div>
                    <div class="cfg-row">
                        <div><div class="cfg-label">Zona horaria</div><div class="cfg-desc">Afecta turnos, recordatorios y reportes</div></div>
                        <select @bind="_zonaHoraria" class="cfg-select">
                            <option value="America/Argentina/Buenos_Aires">Buenos Aires (ART)</option>
                            <option value="America/Argentina/Cordoba">Córdoba (ART)</option>
                            <option value="America/Argentina/Mendoza">Mendoza (ART)</option>
                            <option value="America/Santiago">Santiago (CLT)</option>
                            <option value="America/Montevideo">Montevideo (UYT)</option>
                            <option value="UTC">UTC</option>
                        </select>
                    </div>
                    <div class="cfg-row">
                        <div><div class="cfg-label">Formato de hora</div></div>
                        <select @bind="_formatoHora" class="cfg-select" style="width:160px">
                            <option value="24">24 horas</option>
                            <option value="12">12 horas (AM/PM)</option>
                        </select>
                    </div>
                </div>

                <div class="cfg-card">
                    <div class="cfg-card-head">
                        <div><div class="cfg-card-title">Días y horarios</div></div>
                    </div>
                    @foreach (var dia in _diasSemana)
                    {
                        <div class="cfg-row">
                            <div style="display:flex; align-items:center; gap:12px; flex:1">
                                <label class="cfg-toggle">
                                    <input type="checkbox" checked="@dia.Activo"
                                           @onchange="e => dia.Activo = (bool)(e.Value ?? false)" />
                                    <span class="cfg-slider" style="@(dia.Activo ? $"background:{ColorPrincipal}" : "")"></span>
                                </label>
                                <div class="cfg-label" style="min-width:90px">@dia.Nombre</div>
                            </div>
                            <div style="display:flex; align-items:center; gap:8px;
                                        opacity:@(!dia.Activo ? "0.3" : "1");
                                        pointer-events:@(!dia.Activo ? "none" : "auto")">
                                <input type="text" @bind="dia.Apertura" class="cfg-input" style="width:75px; text-align:center" />
                                <span class="cfg-desc">→</span>
                                <input type="text" @bind="dia.Cierre"   class="cfg-input" style="width:75px; text-align:center" />
                            </div>
                        </div>
                    }
                </div>
            }

            @* ══ NOTIFICACIONES ════════════════════════════════════════════ *@
            @if (TabActivo == "notificaciones")
            {
                @if (_mensajeN is not null)
                {
                    <div class="cfg-toast" style="border-color:@ColorPrincipal;background:@(ColorPrincipal + "18");color:@ColorPrincipal">
                        @_mensajeN
                    </div>
                }

                <div class="cfg-card">
                    <div class="cfg-card-head">
                        <div><div class="cfg-card-title">Canal de envío</div></div>
                        <button class="cfg-btn-save" style="background:@ColorPrincipal" @onclick="GuardarNotificaciones">Guardar</button>
                    </div>
                    <div class="cfg-row">
                        <div><div class="cfg-label">Email de notificaciones</div></div>
                        <input type="email" @bind="_emailNotif" class="cfg-input" />
                    </div>
                    <div class="cfg-row">
                        <div><div class="cfg-label">WhatsApp / teléfono</div><div class="cfg-desc">Para alertas urgentes</div></div>
                        <input type="text" @bind="_telefonoNotif" class="cfg-input" placeholder="+54 11 XXXX-XXXX" />
                    </div>
                </div>

                <div class="cfg-card">
                    <div class="cfg-card-head"><div class="cfg-card-title">Tipos de alerta</div></div>
                    <div class="cfg-row">
                        <div><div class="cfg-label">Nuevo pedido recibido</div></div>
                        <label class="cfg-toggle"><input type="checkbox" @bind="_notifNuevoPedido" /><span class="cfg-slider" style="@(_notifNuevoPedido ? $"background:{ColorPrincipal}" : "")"></span></label>
                    </div>
                    <div class="cfg-row">
                        <div><div class="cfg-label">Stock bajo</div><div class="cfg-desc">Menos de @_stockMinimo unidades</div></div>
                        <div style="display:flex; align-items:center; gap:10px;">
                            <input type="number" @bind="_stockMinimo" class="cfg-input" style="width:70px" min="1" max="99" />
                            <label class="cfg-toggle"><input type="checkbox" @bind="_notifStockBajo" /><span class="cfg-slider" style="@(_notifStockBajo ? $"background:{ColorPrincipal}" : "")"></span></label>
                        </div>
                    </div>
                    <div class="cfg-row">
                        <div><div class="cfg-label">Recordatorio de turno</div><div class="cfg-desc">24 hs antes del turno agendado</div></div>
                        <label class="cfg-toggle"><input type="checkbox" @bind="_notifTurno" /><span class="cfg-slider" style="@(_notifTurno ? $"background:{ColorPrincipal}" : "")"></span></label>
                    </div>
                    <div class="cfg-row">
                        <div><div class="cfg-label">Reseña nueva de cliente</div></div>
                        <label class="cfg-toggle"><input type="checkbox" @bind="_notifResena" /><span class="cfg-slider" style="@(_notifResena ? $"background:{ColorPrincipal}" : "")"></span></label>
                    </div>
                    <div class="cfg-row">
                        <div><div class="cfg-label">Informe semanal de ventas</div><div class="cfg-desc">Cada lunes a las 8:00</div></div>
                        <label class="cfg-toggle"><input type="checkbox" @bind="_notifInforme" /><span class="cfg-slider" style="@(_notifInforme ? $"background:{ColorPrincipal}" : "")"></span></label>
                    </div>
                    <div class="cfg-row">
                        <div><div class="cfg-label">Notificaciones push en el panel</div></div>
                        <label class="cfg-toggle"><input type="checkbox" @bind="_notifPush" /><span class="cfg-slider" style="@(_notifPush ? $"background:{ColorPrincipal}" : "")"></span></label>
                    </div>
                </div>
            }

            @* ══ GENERAL ══════════════════════════════════════════════════ *@
            @if (TabActivo == "general")
            {
                <div class="cfg-card">
                    <div class="cfg-card-head"><div class="cfg-card-title">Información de la aplicación</div></div>
                    <div class="cfg-row">
                        <div class="cfg-label">Versión</div>
                        <span class="cfg-desc">1.0.0 · Blazor Server</span>
                    </div>
                    <div class="cfg-row">
                        <div class="cfg-label">Namespace</div>
                        <span class="cfg-desc" style="font-family:monospace">PerfumeriaAnita</span>
                    </div>
                    <div class="cfg-row">
                        <div class="cfg-label">Última configuración guardada</div>
                        <span class="cfg-desc">@_ultimoGuardado</span>
                    </div>
                </div>
            }

            @* ══ VENTA ════════════════════════════════════════════════════════ *@
            @if (TabActivo == "venta")
            {
                @if (_mensajeV is not null)
                {
                    <div class="cfg-toast" style="border-color:@ColorPrincipal;background:@(ColorPrincipal + "18");color:@ColorPrincipal">
                        @_mensajeV
                    </div>
                }

                @* ── Card: Porcentaje de aumento automático ── *@
                <div class="cfg-card">
                    <div class="cfg-card-head">
                        <div>
                            <div class="cfg-card-title">Margen de ganancia</div>
                            <div class="cfg-card-sub">Porcentaje de aumento automático al cargar productos</div>
                        </div>
                        <button class="cfg-btn-save" style="background:@ColorPrincipal" @onclick="GuardarVenta">
                            Guardar
                        </button>
                    </div>
                    <div class="cfg-row">
                        <div>
                            <div class="cfg-label">% de aumento</div>
                            <div class="cfg-desc">Se aplica automáticamente al precio de costo para calcular el precio de venta</div>
                        </div>
                        <div style="display:flex; align-items:center; gap:8px;">
                            <input type="number" @bind="_porcentajeAumento" @bind:event="oninput" 
                                   class="cfg-input" style="width:100px;" min="0" max="999" step="1" />
                            <span class="cfg-desc">%</span>
                        </div>
                    </div>
                    <div class="cfg-row">
                        <div>
                            <div class="cfg-label">Vista previa</div>
                            <div class="cfg-desc">Cómo se vería el cálculo</div>
                        </div>
                        <div style="display:flex; align-items:center; gap:12px; font-size:12px; color:#64748b;">
                            <span>$1000</span>
                            <span style="color:#94a3b8;">×</span>
                            <span>(1 + @(_porcentajeAumento)% / 100)</span>
                            <span style="color:#94a3b8;">=</span>
                            <span style="font-weight:600; color:@ColorPrincipal;">
                                $@Math.Round(1000 * (1 + _porcentajeAumento / 100M), 2).ToString("F0")
                            </span>
                        </div>
                    </div>
                </div>
            }

            @* ══ SEGURIDAD ══════════════════════════════════════════════════ *@
            @if (TabActivo == "seguridad")
            {
                @if (_mensajeSeguridad is not null)
                {
                    <div class="cfg-toast" style="border-color:@ColorPrincipal;background:@(ColorPrincipal + "18");color:@ColorPrincipal">
                        @_mensajeSeguridad
                    </div>
                }
                @if (_mensajeSeguridadError is not null)
                {
                    <div class="cfg-toast" style="border-color:#e24b4a;background:#e24b4a18;color:#e24b4a">
                        @_mensajeSeguridadError
                    </div>
                }

                <div class="cfg-card">
                    <div class="cfg-card-head">
                        <div>
                            <div class="cfg-card-title">Datos de Acceso</div>
                            <div class="cfg-card-sub">Actualizá tus credenciales de inicio de sesión</div>
                        </div>
                        <button class="cfg-btn-save" style="background:@ColorPrincipal" @onclick="GuardarSeguridad">
                            Guardar
                        </button>
                    </div>
                    <div class="cfg-row">
                        <div>
                            <div class="cfg-label">Nombre de usuario</div>
                            <div class="cfg-desc">El nombre que usás para iniciar sesión</div>
                        </div>
                        <input type="text" @bind="_nuevoNombreUsuario" class="cfg-input" />
                    </div>
                    <div class="cfg-row">
                        <div>
                            <div class="cfg-label">Nueva contraseña</div>
                            <div class="cfg-desc">Dejá en blanco si no la querés cambiar (mínimo 6 caracteres)</div>
                        </div>
                        <input type="password" @bind="_nuevaContraseña" class="cfg-input" placeholder="Nueva contraseña" />
                    </div>
                    <div class="cfg-row">
                        <div>
                            <div class="cfg-label">Confirmar contraseña</div>
                            <div class="cfg-desc">Repetí la nueva contraseña para confirmar</div>
                        </div>
                        <input type="password" @bind="_confirmarContraseña" class="cfg-input" placeholder="Confirmar contraseña" />
                    </div>
                </div>
            }

        </div>
    }
</div>

@code {
    private string TabActivo = "apariencia";
    private bool _cargando = true;

    // ── Apariencia ─────────────────────────────────────────────────────────
    private string _nombreTienda  = "Perfumería Anita";
    private string _eslogan       = "Tu perfume, tu identidad";
    private string ColorPrincipal = "#D4537E";
    private string? _logoBase64;
    private string? _errorLogo;
    private string? _mensajeAp;

    private readonly string[] _coloresPredefinidos =
    {
        "#D4537E", "#E24B4A", "#EF9F27", "#7F77DD", "#1D9E75", "#378ADD", "#888780"
    };

    // ── Horarios ───────────────────────────────────────────────────────────
    private string _zonaHoraria = "America/Argentina/Buenos_Aires";
    private string _formatoHora = "24";
    private string? _mensajeH;

    private List<DiaHorario> _diasSemana = new()
    {
        new("Lunes",     true,  "09:00", "19:00"),
        new("Martes",    true,  "09:00", "19:00"),
        new("Miércoles", true,  "09:00", "19:00"),
        new("Jueves",    true,  "09:00", "19:00"),
        new("Viernes",   true,  "09:00", "19:00"),
        new("Sábado",    true,  "09:00", "14:00"),
        new("Domingo",   false, "—",     "—"),
    };

    // ── Notificaciones ─────────────────────────────────────────────────────
    private string _emailNotif      = "anita@perfumeria.com";
    private string _telefonoNotif   = "";
    private bool   _notifNuevoPedido = true;
    private bool   _notifStockBajo   = true;
    private bool   _notifTurno       = true;
    private bool   _notifResena      = false;
    private bool   _notifInforme     = true;
    private bool   _notifPush        = true;
    private int    _stockMinimo      = 5;
    private string? _mensajeN;

    // ── Venta ───────────────────────────────────────────────────────────────
    private decimal _porcentajeAumento = 30;
    private string? _mensajeV;

    // ── Seguridad ───────────────────────────────────────────────────────────
    private string _nuevoNombreUsuario = "";
    private string _nuevaContraseña = "";
    private string _confirmarContraseña = "";
    private string? _mensajeSeguridad;
    private string? _mensajeSeguridadError;

    private string _ultimoGuardado = "—";

    // ── Lifecycle ──────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await ConfigService.SeedDefaultsAsync();
        await CargarConfiguraciones();
    }

    private async Task CargarConfiguraciones()
    {
        _cargando = true;
        var all = await ConfigService.GetAllAsync();

        _nombreTienda     = all.GetValueOrDefault(AppConfig.Keys.NombreTienda,     "Perfumería Anita");
        _eslogan          = all.GetValueOrDefault(AppConfig.Keys.EsloganTienda,    "Tu perfume, tu identidad");
        ColorPrincipal    = all.GetValueOrDefault(AppConfig.Keys.ColorPrincipal,   "#D4537E");
        var logoGuardado  = all.GetValueOrDefault(AppConfig.Keys.LogoBase64,       "");
        _logoBase64       = string.IsNullOrEmpty(logoGuardado) ? null : logoGuardado;

        _zonaHoraria      = all.GetValueOrDefault(AppConfig.Keys.ZonaHoraria,      "America/Argentina/Buenos_Aires");
        _formatoHora      = all.GetValueOrDefault(AppConfig.Keys.FormatoHora,      "24");
        _emailNotif       = all.GetValueOrDefault(AppConfig.Keys.EmailNotif,       "anita@perfumeria.com");
        _telefonoNotif    = all.GetValueOrDefault(AppConfig.Keys.TelefonoNotif,    "");
        _notifNuevoPedido = all.GetValueOrDefault(AppConfig.Keys.NotifNuevoPedido, "true") == "true";
        _notifStockBajo   = all.GetValueOrDefault(AppConfig.Keys.NotifStockBajo,   "true") == "true";
        _notifTurno       = all.GetValueOrDefault(AppConfig.Keys.NotifTurno,       "true") == "true";
        _notifResena      = all.GetValueOrDefault(AppConfig.Keys.NotifResena,      "false") == "true";
        _notifInforme     = all.GetValueOrDefault(AppConfig.Keys.NotifInforme,     "true") == "true";
        _notifPush        = all.GetValueOrDefault(AppConfig.Keys.NotifPush,        "true") == "true";
        int.TryParse(all.GetValueOrDefault(AppConfig.Keys.StockMinimoAlerta, "5"), out _stockMinimo);
        decimal.TryParse(all.GetValueOrDefault(AppConfig.Keys.PorcentajeAumento, "30"), out _porcentajeAumento);

        if (AuthService.UsuarioActual != null)
        {
            _nuevoNombreUsuario = AuthService.UsuarioActual.Nombre;
        }

        _cargando = false;
    }

    // ── Logo ───────────────────────────────────────────────────────────────
    private async Task OnLogoSeleccionado(InputFileChangeEventArgs e)
    {
        _errorLogo = null;
        var file = e.File;

        // Validar tamaño (máx 1 MB)
        if (file.Size > 1 * 1024 * 1024)
        {
            _errorLogo = "El archivo es demasiado grande. Máximo 1 MB.";
            return;
        }

        // Validar tipo
        var tiposPermitidos = new[] { "image/png", "image/jpeg", "image/svg+xml", "image/webp" };
        if (!tiposPermitidos.Contains(file.ContentType))
        {
            _errorLogo = "Formato no soportado. Usá PNG, JPG, SVG o WEBP.";
            return;
        }

        // Leer y convertir a base64
        using var stream = file.OpenReadStream(maxAllowedSize: 1 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var bytes = ms.ToArray();
        _logoBase64 = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes)}";
    }

    private void EliminarLogo()
    {
        _logoBase64 = null;
        _errorLogo  = null;
    }

