@page "/bienvenida"
@rendermode InteractiveServer
@layout PerfumeriaAnita.Components.Layout.EmptyLayout
@using PerfumeriaAnita.Services
@inject AppConfigState ConfigState
@inject IConfigService ConfigService
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Bienvenida - Perfumería Anita</PageTitle>

<style>
    :root {
        --color-primario: @ColorPrincipal;
        --color-primario-rgb: @ColorPrincipalRgb;
    }

    .bienvenida-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        width: 100vw;
        background: #0f172a; /* Fondo oscuro premium */
        position: relative;
        overflow: hidden;
        font-family: 'Outfit', 'Inter', 'Segoe UI', sans-serif;
    }

    /* Elementos flotantes para el efecto de desenfoque (blur) de fondo */
    .blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(120px);
        opacity: 0.55;
        z-index: 1;
        transition: background-color 0.8s ease, transform 10s ease-in-out;
    }

    .blob-1 {
        top: -10%;
        left: -10%;
        width: 450px;
        height: 450px;
        background-color: var(--color-primario);
        animation: float-slow 15s infinite alternate;
    }

    .blob-2 {
        bottom: -15%;
        right: -10%;
        width: 500px;
        height: 500px;
        background-color: #3b82f6; /* Azul de contraste */
        animation: float-slow 20s infinite alternate-reverse;
    }

    .blob-3 {
        top: 40%;
        left: 60%;
        width: 300px;
        height: 300px;
        background-color: var(--color-primario);
        opacity: 0.35;
        animation: float-slow 18s infinite alternate;
    }

    @@keyframes float-slow {
        0% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(50px, 30px) scale(1.1); }
        100% { transform: translate(-30px, -50px) scale(0.95); }
    }

    /* Tarjeta de bienvenida con Glassmorphism (vidrio esmerilado) */
    .bienvenida-card {
        position: relative;
        z-index: 10;
        background: rgba(255, 255, 255, 0.08); /* Fondo ultra translúcido */
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 28px;
        width: 100%;
        max-width: 450px;
        padding: 45px 35px;
        box-sizing: border-box;
        text-align: center;
        animation: card-appear 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes card-appear {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .icono-bienvenida {
        font-size: 64px;
        margin-bottom: 20px;
        display: inline-block;
        color: var(--color-primario);
        transition: color 0.5s ease;
    }

    .bienvenida-titulo {
        color: #ffffff;
        font-size: 28px;
        font-weight: 800;
        margin: 0;
        letter-spacing: -0.5px;
    }

    .bienvenida-texto {
        color: #cbd5e1;
        font-size: 15px;
        margin: 15px 0 35px 0;
        line-height: 1.6;
    }

    .btn-ingresar {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background-color: var(--color-primario);
        color: white;
        text-decoration: none;
        padding: 14px 28px;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 700;
        transition: all 0.3s;
        border: none;
        cursor: pointer;
        width: 100%;
        box-sizing: border-box;
        box-shadow: 0 4px 15px rgba(var(--color-primario-rgb), 0.3);
    }

    .btn-ingresar:hover {
        filter: brightness(1.1);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(var(--color-primario-rgb), 0.45);
        color: white;
        text-decoration: none;
    }
</style>

<div class="bienvenida-container">
    <!-- Blobs de color de fondo desenfocados -->
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>

    <!-- Tarjeta de Bienvenida -->
    <div class="bienvenida-card">
        <div class="icono-bienvenida">
            <span class="material-symbols-outlined" style="font-size: 64px;">local_florist</span>
        </div>
        
        <h1 class="bienvenida-titulo">¡Hola, Anita!</h1>
        <p class="bienvenida-texto">
            Tu sistema de gestión está listo. Controlá tu inventario, registrá tus ventas y visualizá el rendimiento de tu negocio de forma simple y rápida.
        </p>
        
        <a href="/dashboard" class="btn-ingresar">
            Ir al Dashboard 
            <span class="material-symbols-outlined" style="font-size: 20px;">arrow_forward</span>
        </a>
    </div>
</div>

@code {
    // Propiedades calculadas a partir del estado de la configuración
    private string ColorPrincipal => ConfigState.ColorPrincipal;

    // Convertir el color hex en formato RGB para sombras CSS semitransparentes
    private string ColorPrincipalRgb
    {
        get
        {
            try
            {
                var hex = ColorPrincipal.Replace("#", "");
                if (hex.Length == 6)
                {
                    var r = Convert.ToInt32(hex.Substring(0, 2), 16);
                    var g = Convert.ToInt32(hex.Substring(2, 2), 16);
                    var b = Convert.ToInt32(hex.Substring(4, 2), 16);
                    return $"{r}, {g}, {b}";
                }
            }
            catch { }
            return "212, 83, 126"; // Rosa fallback rgb
        }
    }

    protected override void OnInitialized()
    {
        // Si no está autenticado, redirigir al login
        if (!AuthService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/");
        }
    }
}