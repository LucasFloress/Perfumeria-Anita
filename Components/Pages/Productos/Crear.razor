@page "/inventario/crear"
@using Microsoft.EntityFrameworkCore 
@using PerfumeriaAnita.Models
@using PerfumeriaAnita.Data
@inject AppDbContext Contexto
@inject NavigationManager Navegador
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" GutterBottom="true">Nuevo Producto</MudText>

<EditForm Model="@producto" OnValidSubmit="GuardarProducto">
    <DataAnnotationsValidator />
    
    <MudCard>
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField   Label="Nombre del Producto" 
                                    @bind-Value="producto.Nombre" 
                                    For="@(() => producto.Nombre)" 
                                    Variant="Variant.Outlined"/>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField   Label="Código de Barras" 
                                    @bind-Value="producto.CodigoBarras" 
                                    For="@(() => producto.CodigoBarras)" 
                                    Variant="Variant.Outlined"/>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" Label="Categoría" @bind-Value="producto.CategoriaId" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="int?" Value="null">-- Seleccione --</MudSelectItem>
                        @foreach (var cat in categorias)
                        {
                            <MudSelectItem T="int?" Value="@cat.Id">@cat.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="3">
                    <MudNumericField    Label="Precio" 
                                        @bind-Value="producto.Precio" 
                                        Format="C2" 
                                        Variant="Variant.Outlined"
                                        For="@(() => producto.Precio)" />
                </MudItem>

                <MudItem xs="12" sm="3">
                    <MudNumericField    Label="Stock" 
                                        @bind-Value="producto.Stock" 
                                        Variant="Variant.Outlined"
                                        For="@(() => producto.Stock)" />
                </MudItem>

                <MudItem xs="12">
                        <MudSwitch T="bool?" @bind-Value="producto.Activo" Label="Producto Activo" Color="Color.Success" />
                </MudItem>

            </MudGrid>
        </MudCardContent>
        
        <MudCardActions>
            <MudButton  ButtonType="ButtonType.Submit" 
                        Variant="Variant.Filled" 
                        Color="Color.Primary" 
                        Class="ml-auto">
                Guardar Producto
            </MudButton>
        </MudCardActions>
    </MudCard>
</EditForm>

@code {
    private Producto producto = new Producto();
    private List<Categoria> categorias = new();

    protected override async Task OnInitializedAsync()
    {
        // Cargar categorías para el desplegable
        categorias = await Contexto.Categorias
                                .Where(c => c.Activo)
                                .OrderBy(c => c.Nombre)
                                .ToListAsync(); // <-- AHORA FUNCIONARÁ PORQUE AGREGAMOS EL USING ARRIBA
    }

    private async Task GuardarProducto()
    {
        // Validar que no exista el código de barras
        var existe = await Contexto.Productos.AnyAsync(p => p.CodigoBarras == producto.CodigoBarras);
        if (existe)
        {
            Snackbar.Add("¡Ese código de barras ya existe!", Severity.Error);
            return;
        }
        
        Contexto.Productos.Add(producto);
        await Contexto.SaveChangesAsync();

        Snackbar.Add("¡Producto creado con éxito!", Severity.Success);
        Navegador.NavigateTo("/productos");
    }
}