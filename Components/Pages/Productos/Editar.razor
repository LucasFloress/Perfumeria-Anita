@page "/productos/editar/{Id:int}"
@using PerfumeriaAnita.Models
@using PerfumeriaAnita.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Contexto
@inject NavigationManager Navegador
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4">Editar Producto</MudText>

@if (producto == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <EditForm Model="@producto" OnValidSubmit="ActualizarProducto">
        <DataAnnotationsValidator/> 
        <MudCard>
            <MudCardContent>
                <MudTextField Label="Nombre" @bind-Value="producto.Nombre" Variant="Variant.Outlined" />
                <MudTextField Label="Código" @bind-Value="producto.CodigoBarras" Variant="Variant.Outlined" />
                <MudSwitch T="bool?" @bind-Value="producto.Activo" Label="Activo" Color="Color.Success" />
            </MudCardContent>
            <MudCardActions>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Actualizar</MudButton>
                <MudButton OnClick="Cancelar">Cancelar</MudButton>
            </MudCardActions>
        </MudCard>
    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }
    private Producto? producto;

    protected override async Task OnInitializedAsync()
    {
        producto = await Contexto.Productos.FindAsync(Id);
    }

    private async Task ActualizarProducto()
    {
        Contexto.Productos.Update(producto!);
        await Contexto.SaveChangesAsync();
        Snackbar.Add("Actualizado", Severity.Success);
        Navegador.NavigateTo("/inventario");
    }

    private void Cancelar() => Navegador.NavigateTo("/inventario");
}