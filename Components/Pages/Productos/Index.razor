@page "/productos"
@using Microsoft.EntityFrameworkCore
@using PerfumeriaAnita.Models
@using PerfumeriaAnita.Data
@inject AppDbContext Contexto
@inject NavigationManager Navegador
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" GutterBottom="true">
    <MudIcon Icon="@Icons.Material.Filled.Inventory"/> Productos
</MudText>

<MudButton Variant="Variant.Filled" 
        Color="Color.Primary"
        StartIcon="@Icons.Material.Filled.Add"
        Href="/productos/crear"
        Class="mb-4">
    Nuevo Producto
</MudButton>

<MudTable Items="@productos" 
        Loading="@cargando"
        Dense="true" 
        Hover="true"
        Filter="new Func<Producto, bool>(FiltrarProducto)">
    
    <ToolBarContent>
        <MudText Typo="Typo.h6">Listado de Productos</MudText>
        <MudSpacer/>
        <MudTextField @bind-Value="textoBusqueda" 
                    Placeholder="Buscar..." 
                    Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search"
                    IconSize="Size.Medium"
                    Immediate="true"/>
    </ToolBarContent>

    <HeaderContent>
        <MudTh>Código</MudTh>
        <MudTh>Nombre</MudTh>
        <MudTh>Categoría</MudTh>
        <MudTh>Precio</MudTh>
        <MudTh>Stock</MudTh>
        <MudTh>Estado</MudTh>
        <MudTh>Acciones</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="Código">
            <code>@context.CodigoBarras</code>
        </MudTd>
        <MudTd DataLabel="Nombre">
            <strong>@context.Nombre</strong>
        </MudTd>
        <MudTd DataLabel="Categoría">
            @if (context.Categoria != null)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Info">
                    @context.Categoria.Nombre
                </MudChip>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Default">-</MudText>
            }
        </MudTd>
        <MudTd DataLabel="Precio">
            <strong>$@context.Precio.ToString("N2")</strong>
        </MudTd>
        <MudTd DataLabel="Stock">
            <MudChip T="string" Size="Size.Small" 
                     Color="@ObtenerColorStock(context.Stock)">
                @context.Stock
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Estado">
            <MudChip T="string" Size="Size.Small" 
                    Color="@(context.Activo == true ? Color.Success : Color.Default)">
                @(context.Activo == true ? "Activo" : "Inactivo")
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Acciones">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                           Size="Size.Small"
                           Color="Color.Primary"
                           Href="@($"/productos/editar/{context.Id}")"/>
            
            <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                           Size="Size.Small"
                           Color="Color.Error"
                           OnClick="@(() => EliminarProducto(context.Id))"/>
        </MudTd>
    </RowTemplate>

    <NoRecordsContent>
        <MudText>No hay productos registrados</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private List<Producto> productos = new();
    private bool cargando = true;
    private string textoBusqueda = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
    }

    private async Task CargarProductos()
    {
        cargando = true;
        // El Include requiere "using Microsoft.EntityFrameworkCore" arriba
        productos = await Contexto.Productos
            .Include(p => p.Categoria)
            .OrderBy(p => p.Nombre)
            .ToListAsync();
        cargando = false;
    }

    private bool FiltrarProducto(Producto producto)
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda))
            return true;

        if (producto.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase))
            return true;

        if (producto.CodigoBarras?.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) == true)
            return true;

        return false;
    }

    private Color ObtenerColorStock(int stock)
    {
        if (stock == 0) return Color.Error;
        if (stock <= 5) return Color.Warning;
        return Color.Success;
    }

    private async Task EliminarProducto(int id)
    {
        var producto = await Contexto.Productos.FindAsync(id);
        if (producto != null)
        {
            // Soft delete (desactivar en vez de borrar)
            producto.Activo = false;
            await Contexto.SaveChangesAsync();
            
            Snackbar.Add("Producto desactivado", Severity.Info);
            await CargarProductos();
        }
    }
}