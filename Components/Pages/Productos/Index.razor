@page "/inventario"
@rendermode InteractiveServer
@using PerfumeriaAnita.Models
@using PerfumeriaAnita.Data
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@inject AppDbContext Contexto
@inject ISnackbar Snackbar
@inject PerfumeriaAnita.Services.IConfigService ConfigService

<PageTitle>Inventario - Perfumería Anita</PageTitle>

<style>
    /* Sobrescribimos el violeta por defecto con el color dinámico de la BD */
    .btn-nuevo { background-color: @_colorPrincipal !important; }
    .btn-nuevo:hover { filter: brightness(0.85); /* Oscurece el color dinámico al pasar el mouse */ }
    
    .input-busqueda:focus { border-color: @_colorPrincipal !important; }
    .input-busqueda.escaner-activo { border-color: @_colorPrincipal !important; }
    
    .feedback-hint { border-color: @_colorPrincipal !important; color: @_colorPrincipal !important; }
    .text-violeta { color: @_colorPrincipal !important; }
    
    .btn-pagina.activa { 
        background-color: @_colorPrincipal !important; 
        border-color: @_colorPrincipal !important; 
    }
    .link-gestionar { color: @_colorPrincipal !important; }
</style>

<div class="inventario-wrapper">

    <!-- Alertas de Stock -->
    <div class="card alertas-card">
        <div class="alertas-left">
            <div class="alertas-header">
                <span class="material-symbols-outlined">warning</span>
                <h2>Alertas de Stock Críticas</h2>
                <!-- badge dinámico -->
                @if (AlertasStock.Any())
                {
                    <span class="badge-riesgo">@AlertasStock.Count PRODUCTO@(AlertasStock.Count != 1 ? "S" : "") EN RIESGO</span>
                }
                else
                {
                    <span class="badge-ok">✔ TODO EN ORDEN</span>
                }
            </div>
            <div class="alertas-items">
                @if (!AlertasStock.Any())
                {
                    <p style="color:#888; margin:0; padding: 10px 0;">Sin alertas por el momento</p>
                }
                @foreach (var alerta in AlertasStock)
                {
                    <div class="alerta-item @(alerta.Urgente ? "urgente" : "")">
                        <div class="alerta-nombre">@alerta.Nombre</div>
                        <div class="alerta-ref">Referencia: @alerta.Referencia</div>
                        <div class="alerta-footer">
                            <span class="alerta-unidades @(alerta.Urgente ? "text-rojo" : "text-naranja")">@alerta.Unidades</span>
                            @if (alerta.Urgente)
                            {
                                <span class="badge-urgente">REPOSICIÓN URGENTE</span>
                            }
                            else
                            {
                                <a class="link-gestionar">Gestionar Pedido</a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Ventas del día -->
    <div class="card ventas-card">
        <div class="ventas-header">
            <h3>Ventas del día</h3>
        </div>
        <div class="ventas-monto">$@totalHoy.ToString("N0")</div>
            <div class="ventas-variacion">↗ +12.5% vs ayer</div>
            <div class="ventas-update">Última actualización: 14:25</div>
    </div>

    <!-- Tabla Inventario -->
    <div class="card tabla-card">
        <div class="tabla-header">
            <div>
                <h3>Inventario de Productos</h3>
                <p class="tabla-subtitulo">Gestiona tus productos y existencias</p>
            </div>
            <div class="tabla-controles">
                <select class="select-filtro" @bind="CategoriaFiltro" @bind:after="AplicarFiltros">
                    @foreach (var cat in Categorias)
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>
                <select class="select-filtro" @bind="EstadoFiltro" @bind:after="AplicarFiltros">
                    @foreach (var est in Estados)
                    {
                        <option value="@est">@est</option>
                    }
                </select>
                <button class="btn-secundario" style="background: #f1f5f9; border: 1px solid #cbd5e1; padding: 8px 12px; border-radius: 8px; cursor: pointer; color: #475569; transition: background 0.2s;" 
                        @onclick="RefrescarProductos" title="Recargar todos los datos"><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#000000"><path d="M480-160q-134 0-227-93t-93-227q0-134 93-227t227-93q69 0 132 28.5T720-690v-110h80v280H520v-80h168q-32-56-87.5-88T480-720q-100 0-170 70t-70 170q0 100 70 170t170 70q77 0 139-44t87-116h84q-28 106-114 173t-196 67Z"/></svg></button>
                <button class="btn-secundario" style="background: #f1f5f9; border: 1px solid #cbd5e1; padding: 8px 16px; border-radius: 8px; font-weight: 600; cursor: pointer; color: #475569;" 
                    @onclick="AbrirGestorCategorias">Categorías</button>
                <button class="btn-nuevo" @onclick="AbrirCrear">➕ Nuevo Producto</button>
            </div>
        </div>

        <!--🔍 BARRA DE BÚSQUEDA + ESCÁNER  -->
        <div class="busqueda-row">
            <div class="busqueda-wrapper">
                <span class="busqueda-icon">@(ModoEscaner ? "📷" : "🔍")</span>
                <input
                    @ref="InputBusqueda"
                    class="input-busqueda @(ModoEscaner ? "escaner-activo" : "")"
                    type="text"
                    placeholder="@(ModoEscaner ? "Escanea el código de barras..." : "Buscar por nombre de producto o código...")"
                    value="@TextoBusqueda"
                    @oninput="OnBusquedaInput" />
            </div>
            @if (!string.IsNullOrEmpty(TextoBusqueda))
            {
                <button class="btn-limpiar" @onclick="LimpiarBusqueda">✕</button>
            }
        </div> 

        <!-- Tabla -->
        <table class="tabla-productos">
            <thead>
                <tr>
                    <th>PRODUCTO</th>
                    <th>CATEGORÍA</th>
                    <th>PRECIO</th>
                    <th>STOCK</th>
                    <th>ESTADO</th>
                    <th>ACCIONES</th>
                </tr>
            </thead>
            <tbody>
                @if (!ProductosPaginados.Any())
                {
                    <tr>
                        <td colspan="6" class="sin-resultados">No se encontraron productos</td>
                    </tr>
                }
                else
                {
                    @foreach (var producto in ProductosPaginados)
                    {
                        <tr>
                            <td>
                                <div class="producto-cell">
                                    <div class="producto-thumb">🧴</div>
                                    <div>
                                        <div class="producto-nombre">@producto.Nombre</div>
                                        <div class="producto-sku">Código: @producto.CodigoBarras</div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-gris">@(producto.Categoria?.Nombre ?? "Sin categoría")</td>
                            <td class="text-bold">$@producto.Precio.ToString("N2")</td>
                            <td class="text-bold">@producto.Stock</td>
                            <td>
                                <span class="badge-estado badge-@ObtenerEstadoCss(producto)">@ObtenerEstado(producto)</span>
                            </td>
                            <td>
                                <div class="acciones-cell">
                                    <button class="btn-accion btn-editar" @onclick="() => AbrirEditar(producto)">
                                        <span class="material-symbols-outlined">edit</span>
                                    </button>
                                    <button class="btn-accion btn-borrar" @onclick="() => AbrirEliminar(producto)">
                                        <span class="material-symbols-outlined">delete</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <!-- Paginación -->
        <div class="paginacion">
            <span class="paginacion-info">
                Mostrando @InicioRango–@FinRango de @ProductosFiltrados.Count producto@(ProductosFiltrados.Count != 1 ? "s" : "")
                @if (!string.IsNullOrEmpty(TextoBusqueda))
                {
                    <span class="text-violeta"> (filtrado de @TodosLosProductos.Count)</span>
                }
            </span>
            <div class="paginacion-botones">
                <button class="btn-pagina" disabled="@(PaginaActual == 1)" @onclick="PaginaAnterior">Anterior</button>
                @for (int i = 1; i <= TotalPaginas; i++)
                {
                    var numPagina = i;
                    <button class="btn-pagina @(PaginaActual == numPagina ? "activa" : "")"
                            @onclick="() => IrAPagina(numPagina)">@numPagina</button>
                }
                <button class="btn-pagina" disabled="@(PaginaActual == TotalPaginas || TotalPaginas == 0)" @onclick="PaginaSiguiente">Siguiente</button>
            </div>
        </div>
    </div>
</div>

<ProductoFormModal
    Visible="_modalFormVisible"
    Producto="_productoSeleccionado"
    OnGuardado="RefrescarProductos"
    OnCerrar="CerrarModales" />

<ConfirmarEliminarModal
    Visible="_modalEliminarVisible"
    NombreProducto="@_productoSeleccionado.Nombre"
    OnConfirmar="EliminarConfirmado"
    OnCancelar="CerrarModales" />

<GestorCategoriasModal @ref="_gestorCategorias" OnCambioCategorias="RefrescarProductos" />
@code {

    // ── Datos de la Base de Datos ──────────────────────────
    private List<Producto> TodosLosProductos = new();
    private List<Producto> ProductosFiltrados = new();
    private List<Producto> ProductosPaginados = new();
    private string _colorPrincipal = "7c3aed";
    private int _stockMinimo = 5;

    // ── Alertas ────────────────────────────────────────────
    private List<AlertaStock> AlertasStock = new();

    // ── Filtros ────────────────────────────────────────────
    private string TextoBusqueda = "";
    private string CategoriaFiltro = "Todas las Categorías";
    private string EstadoFiltro = "Todos los Estados";

    private List<string> Categorias = new() { "Todas las Categorías" };
    private List<string> Estados = new() { "Todos los Estados", "EN STOCK", "STOCK BAJO", "AGOTADO", "INACTIVO" };

    // ── Ventas del día ─────────────────────────────────────
    private decimal totalHoy = 0;
    private decimal totalAyer = 0;
    private int ventasAyer = 0;
    private string ultimaActualizacionHoy = "";
    private decimal PorcentajeVariacion = 0m;

    // ── Paginación ─────────────────────────────────────────
    private int PaginaActual = 1;
    private const int ItemsPorPagina = 5;
    private int TotalPaginas => (int)Math.Ceiling((double)ProductosFiltrados.Count / ItemsPorPagina);
    private int InicioRango => ProductosFiltrados.Count == 0 ? 0 : (PaginaActual - 1) * ItemsPorPagina + 1;
    private int FinRango => Math.Min(PaginaActual * ItemsPorPagina, ProductosFiltrados.Count);

    // ── Escáner ────────────────────────────────────────────
    private bool ModoEscaner = false;
    private string FeedbackEscaner = "";
    private bool FeedbackEsEscanerError = false; // distinguir ok vs error en feedback
    private ElementReference InputBusqueda;
    private System.Timers.Timer? _timerEscaner;
    private System.Timers.Timer? _timerFeedback;

    // ── Modales ────────────────────────────────────────────
    private bool _modalFormVisible = false;
    private bool _modalEliminarVisible = false;
    private Producto _productoSeleccionado = new();
    private GestorCategoriasModal _gestorCategorias = default!;

    // ── Lifecycle ──────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        // 1. Buscar el color elegido en la base de datos
        var configColor = await Contexto.AppConfigs
            .FirstOrDefaultAsync(c => c.Clave == "tienda.color_principal");

        if (configColor != null && !string.IsNullOrWhiteSpace(configColor.Valor))
        {
            _colorPrincipal = configColor.Valor;
        }

        // Buscamos el minimo
        var umbralStr = await ConfigService.GetAsync("inventario.stock_minimo","5");
        if (int.TryParse(umbralStr, out int umbralParseado))
        {
            _stockMinimo = umbralParseado;
        }

        // 2. Cargar los productos normalmente
        TodosLosProductos = await Contexto.Productos
            .Include(p => p.Categoria)
            .OrderBy(p => p.Nombre)
            .ToListAsync();
            
        var catsDB = await Contexto.Categorias.Select(c => c.Nombre).ToListAsync();
        Categorias.AddRange(catsDB);

        GenerarAlertas();
        AplicarFiltros();
    }

    // ── Helpers de estado visual ───────────────────────────
    private string ObtenerEstado(Producto p)
    {
        if (p.Activo != true) return "INACTIVO";
        if (p.Stock == 0) return "AGOTADO";
        if (p.Stock <= _stockMinimo) return "STOCK BAJO";
        return "EN STOCK";
    }

    private string ObtenerEstadoCss(Producto p)
    {
        if (p.Activo != true) return "inactivo";
        if (p.Stock == 0) return "agotado";
        if (p.Stock <= _stockMinimo) return "bajo";
        return "stock";
    }

    private void GenerarAlertas()
    {
        AlertasStock.Clear();
        var productosEnRiesgo = TodosLosProductos.Where(p => p.Stock <= _stockMinimo && p.Activo == true).ToList();

        foreach (var p in productosEnRiesgo)
        {
            AlertasStock.Add(new AlertaStock(
                p.Nombre,
                p.CodigoBarras ?? "Sin código",
                p.Stock == 0 ? "AGOTADO" : $"{p.Stock} unidades",
                p.Stock == 0
            ));
        }
    }

    // ── Búsqueda ───────────────────────────────────────────
    private void OnBusquedaInput(ChangeEventArgs e)
    {
        TextoBusqueda = e.Value?.ToString() ?? "";
        var codigoLimpio = TextoBusqueda.Trim();

        // Detectar código de barras: 8+ dígitos numéricos (EAN-8, EAN-13, UPC)
        if (codigoLimpio.Length >= 8 && codigoLimpio.All(char.IsDigit))
        {
            var encontrado = TodosLosProductos.FirstOrDefault(p => p.CodigoBarras == codigoLimpio);

            if (encontrado != null)
            {
                // limpiar el input y mostrar solo el producto encontrado,
                // en lugar de dejar el código escrito en el buscador
                TextoBusqueda = encontrado.Nombre;
                FeedbackEscaner = $"✅ Producto encontrado: {encontrado.Nombre} — Stock: {encontrado.Stock}";
                FeedbackEsEscanerError = false;

                //cancelar el timer de escaneo porque ya encontramos lo que buscábamos
                _timerEscaner?.Dispose();
                ModoEscaner = false;
            }
            else
            {
                // mostrar error si el código no existe
                FeedbackEscaner = $"⚠ Código {codigoLimpio} no encontrado en inventario.";
                FeedbackEsEscanerError = true;
            }

            // Resetear feedback tras 3 segundos (compartido para ok y error)
            _timerFeedback?.Dispose();
            _timerFeedback = new System.Timers.Timer(3000);
            _timerFeedback.Elapsed += (_, _) =>
            {
                FeedbackEscaner = "";
                FeedbackEsEscanerError = false;
                _timerFeedback?.Dispose();
                InvokeAsync(StateHasChanged);
            };
            _timerFeedback.AutoReset = false;
            _timerFeedback.Start();
        }

        AplicarFiltros();
    }

    private void LimpiarBusqueda()
    {
        TextoBusqueda = "";
        FeedbackEscaner = "";
        FeedbackEsEscanerError = false;
        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        var q = TextoBusqueda.Trim().ToLower();

        ProductosFiltrados = TodosLosProductos.Where(p =>
        {
            var matchBusqueda = string.IsNullOrEmpty(q) ||
                                p.Nombre.ToLower().Contains(q) ||
                                (p.CodigoBarras != null && p.CodigoBarras.ToLower().Contains(q)) ||
                                (p.Categoria != null && p.Categoria.Nombre.ToLower().Contains(q));

            var matchCat = CategoriaFiltro == "Todas las Categorías" || p.Categoria?.Nombre == CategoriaFiltro;
            var matchEstado = EstadoFiltro == "Todos los Estados" || ObtenerEstado(p) == EstadoFiltro;

            return matchBusqueda && matchCat && matchEstado;
        }).ToList();

        PaginaActual = 1;
        ActualizarPagina();
    }

    private void ActualizarPagina()
    {
        ProductosPaginados = ProductosFiltrados
            .Skip((PaginaActual - 1) * ItemsPorPagina)
            .Take(ItemsPorPagina)
            .ToList();
    }

    // ── Paginación ─────────────────────────────────────────
    private void PaginaAnterior() { if (PaginaActual > 1) { PaginaActual--; ActualizarPagina(); } }
    private void PaginaSiguiente() { if (PaginaActual < TotalPaginas) { PaginaActual++; ActualizarPagina(); } }
    private void IrAPagina(int n) { PaginaActual = n; ActualizarPagina(); }

    // ── Escáner ────────────────────────────────────────────
    private async Task ActivarEscaner()
    {
        ModoEscaner = true;
        TextoBusqueda = "";
        FeedbackEscaner = "";
        FeedbackEsEscanerError = false;
        AplicarFiltros();
        await InputBusqueda.FocusAsync();

        // dispose antes de crear uno nuevo para evitar timers duplicados
        _timerEscaner?.Dispose();
        _timerEscaner = new System.Timers.Timer(8000);
        _timerEscaner.Elapsed += (_, _) =>
        {
            ModoEscaner = false;
            _timerEscaner?.Dispose();
            InvokeAsync(StateHasChanged);
        };
        _timerEscaner.AutoReset = false;
        _timerEscaner.Start();
    }

    // ── Modales ────────────────────────────────────────────
    private void AbrirCrear()
    {
        _productoSeleccionado = new Producto { Activo = true };
        _modalFormVisible = true;
    }

    private void AbrirEditar(Producto p)
    {
        _productoSeleccionado = new Producto
        {
            Id = p.Id,
            Nombre = p.Nombre,
            CodigoBarras = p.CodigoBarras,
            CategoriaId = p.CategoriaId,
            Precio = p.Precio,
            Stock = p.Stock,
            Activo = p.Activo,
            Imagen = p.Imagen
        };
        _modalFormVisible = true;
    }

    private void AbrirEliminar(Producto p)
    {
        _productoSeleccionado = p;
        _modalEliminarVisible = true;
    }

    private void CerrarModales()
    {
        _modalFormVisible = false;
        _modalEliminarVisible = false;
    }

    private async Task RefrescarProductos()
    {
        CerrarModales();
        // 1. Forzamos a traer la tabla de productos fresca desde la base de datos
        TodosLosProductos = await Contexto.Productos
            .Include(p => p.Categoria)
            .OrderBy(p => p.Nombre)
            .ToListAsync();
            
        // 2. Recargamos los textos de las categorías en el menú desplegable
        var catsDB = await Contexto.Categorias.Where(c => c.Activo).Select(c => c.Nombre).ToListAsync();
        Categorias = new List<string> { "Todas las Categorías" }; 
        Categorias.AddRange(catsDB); 

        // 3. Blanquear todos los filtros
        TextoBusqueda = "";
        CategoriaFiltro = "Todas las Categorías";
        EstadoFiltro = "Todos los Estados";
        ModoEscaner = false;
        FeedbackEscaner = "";
        FeedbackEsEscanerError = false;

        // 4. Re-calculamos todo lo visual
        GenerarAlertas();
        AplicarFiltros();
        
        // 5. Le avisamos a la pantalla que se redibuje obligatoriamente
        StateHasChanged();
    }

    private async Task EliminarConfirmado()
    {
        var p = await Contexto.Productos.FindAsync(_productoSeleccionado.Id);
        if (p != null)
        {
            // En lugar de hacer Remove(p), hacemos una baja lógica
            p.Activo = false;
            Contexto.Productos.Update(p);
            
            await Contexto.SaveChangesAsync();
            Snackbar.Add("Producto desactivado correctamente.", Severity.Success);
        }
        await RefrescarProductos();
    }

    private async Task AbrirGestorCategorias()
    {
        await _gestorCategorias.AbrirModal();
    }

    // IAsyncDisposable en lugar de IDisposable
    public async ValueTask DisposeAsync()
    {
        _timerEscaner?.Dispose();
        _timerFeedback?.Dispose();
        await ValueTask.CompletedTask;
    }

    // ── Modelo interno para alertas ────────────────────────
    public class AlertaStock
    {
        public string Nombre { get; set; }
        public string Referencia { get; set; }
        public string Unidades { get; set; }
        public bool Urgente { get; set; }

        public AlertaStock(string nombre, string referencia, string unidades, bool urgente)
        {
            Nombre = nombre;
            Referencia = referencia;
            Unidades = unidades;
            Urgente = urgente;
        }
    }

    // ── OnKeyDown ──────────────────────────────────────────────
    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(TextoBusqueda))
        {
            // Si el oninput ya procesó el código, el Enter solo limpia el input
            // Si el usuario escribió algo manualmente y presionó Enter, aplicamos filtros
            if (TextoBusqueda.Trim().All(char.IsDigit) && TextoBusqueda.Trim().Length >= 8)
            {
                // El lector ya procesó esto en oninput, solo limpiamos
                TextoBusqueda = "";
                AplicarFiltros();
            }
            // Si es texto (búsqueda manual), el filtro ya se aplicó en oninput, no hacemos nada más
        }
    }

}