@using PerfumeriaAnita.Models
@using PerfumeriaAnita.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Contexto

@if (EstaAbierto && VentaSeleccionada != null)
{
    <style>
        /* 🎨 Sobrescribimos el color rosa (#e91e63) por el color dinámico de configuración */
        .modal-icon { color: @_colorPrincipal !important; }
        .modal-close:hover { color: @_colorPrincipal !important; }
        .modal-footer-count .material-symbols-outlined { color: @_colorPrincipal !important; }
        .texto-primario { color: @_colorPrincipal !important; }
    </style>

    <div class="modal-backdrop" @onclick="CerrarModal"></div>

    <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="modal-title">

        <!-- ── Header ── -->
        <div class="modal-header">
            <div class="modal-header-left">
                <div class="modal-icon">
                    <span class="material-symbols-outlined">receipt_long</span>
                </div>
                <div>
                    <h2 id="modal-title" class="modal-title">Detalle del Ticket #@VentaSeleccionada.Id.ToString("D5")</h2>
                    <p class="modal-subtitle">
                        @VentaSeleccionada.Fecha.ToString("dd/MM/yyyy a las HH:mm") • Pagado con @VentaSeleccionada.MetodoPago
                    </p>
                </div>
            </div>
            <button class="modal-close" @onclick="CerrarModal" aria-label="Cerrar">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <!-- ── Tabla de Detalles ── -->
        <div class="modal-table-wrapper" style="padding-top: 10px;">
            <table class="ventas-table modal-table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Precio Unitario</th>
                        <th style="text-align: center;">Cantidad</th>
                        <th style="text-align: right; padding-right: 2rem;">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detalle in VentaSeleccionada.Detalles)
                    {
                        <tr>
                            <td>
                                <div class="td-producto">
                                    <div class="icon-box">
                                        <span class="material-symbols-outlined">sanitizer</span>
                                    </div>
                                    <span class="producto-nombre">
                                        @(detalle.Producto?.Nombre ?? "Producto Eliminado")
                                    </span>
                                </div>
                            </td>
                            <td class="td-precio" style="color: #64748b; font-weight: normal;">
                                $@detalle.PrecioUnitario.ToString("N2")
                            </td>
                            <td style="text-align: center;">
                                <span style="background: #f1f5f9; padding: 4px 10px; border-radius: 20px; font-size: 0.85rem; font-weight: bold; color: #334155;">
                                    x @detalle.Cantidad
                                </span>
                            </td>
                            <td class="td-precio" style="text-align: right; padding-right: 2rem;">
                                $@((detalle.PrecioUnitario * detalle.Cantidad).ToString("N2"))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- ── Footer ── -->
        <div class="modal-footer">
            <span class="modal-footer-count">
                <span class="material-symbols-outlined">shopping_bag</span>
                @VentaSeleccionada.Detalles.Sum(d => d.Cantidad) artículos en total
            </span>
            <div class="modal-footer-totals">
                <span class="footer-total-label">Total Cobrado:</span>
                <span class="footer-total-amount texto-primario">$@VentaSeleccionada.Total.ToString("N2")</span>
            </div>
        </div>

    </div>
}

@code {
    [Parameter] public EventCallback OnCerrar { get; set; }

    // Cambiamos la Lista por una sola Venta
    private Venta? VentaSeleccionada; 
    private bool EstaAbierto = false;

    private string _colorPrincipal = "#e91e63"; 

    protected override async Task OnInitializedAsync()
    {
        var configColor = await Contexto.AppConfigs
            .FirstOrDefaultAsync(c => c.Clave == "tienda.color_principal");

        if (configColor != null && !string.IsNullOrWhiteSpace(configColor.Valor))
        {
            _colorPrincipal = configColor.Valor;
        }
    }

    // Le pasamos la venta específica como parámetro al abrir
    public void AbrirModal(Venta ventaParaMostrar)
    {
        VentaSeleccionada = ventaParaMostrar;
        EstaAbierto = true;
        StateHasChanged();
    }

    private async Task CerrarModal()
    {
        EstaAbierto = false;
        VentaSeleccionada = null;
        await OnCerrar.InvokeAsync();
        StateHasChanged();
    }
}