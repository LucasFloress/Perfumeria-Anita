@* Components/ProductoFormModal.razor *@
@using PerfumeriaAnita.Models
@using PerfumeriaAnita.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Contexto

@if (Visible)
{
    <div class="modal-backdrop" @onclick="Cerrar"></div>
    <div class="modal-box" @onclick:stopPropagation>

        <div class="modal-header">
            <h3>@(Producto.Id == 0 ? "➕ Nuevo Producto" : "✏️ Editar Producto")</h3>
            <button class="btn-cerrar" @onclick="Cerrar">✕</button>
        </div>

        <EditForm Model="Producto" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />

            <div class="form-grid">

                @* Nombre *@
                <div class="form-group full-width">
                    <label>Nombre *</label>
                    <InputText @bind-Value="Producto.Nombre" class="form-input" placeholder="Ej: Chanel N°5 EDP 100ml" />
                    <ValidationMessage For="@(() => Producto.Nombre)" />
                </div>

                @* Código de Barras *@
                <div class="form-group">
                    <label>Código de Barras</label>
                    <InputText @bind-Value="Producto.CodigoBarras" class="form-input" placeholder="Ej: 7891234567890" />
                </div>

                @* Categoría *@
                <div class="form-group">
                    <label>Categoría *</label>
                    <InputSelect @bind-Value="Producto.CategoriaId" class="form-input">
                        <option value="">-- Seleccionar --</option>
                        @foreach (var cat in _categorias)
                        {
                            <option value="@cat.Id">@cat.Nombre</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => Producto.CategoriaId)" />
                </div>

                @* Precio *@
                <div class="form-group">
                    <label>Precio *</label>
                    <InputNumber @bind-Value="Producto.Precio" class="form-input" />
                    <ValidationMessage For="@(() => Producto.Precio)" />
                </div>

                @* Stock *@
                <div class="form-group">
                    <label>Stock *</label>
                    <InputNumber @bind-Value="Producto.Stock" class="form-input" />
                    <ValidationMessage For="@(() => Producto.Stock)" />
                </div>

                @* Activo *@
                <div class="form-group checkbox-group">
                    <label>
                        <input type="checkbox"
                               checked="@(Producto.Activo == true)"
                               @onchange="@(e => Producto.Activo = (bool)(e.Value ?? false))" />
                        Producto activo
                    </label>
                </div>

                @* Imagen (opcional) *@
                <div class="form-group full-width">
                    <label>Imagen (opcional)</label>
                    <InputFile OnChange="CargarImagen" accept="image/*" class="form-input" />
                    @if (_imagenPreview != null)
                    {
                        <img src="@_imagenPreview" alt="Preview" class="img-preview" />
                    }
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn-cancelar" @onclick="Cerrar">Cancelar</button>
                <button type="submit" class="btn-guardar" disabled="@_guardando">
                    @(_guardando ? "Guardando..." : "Guardar")
                </button>
            </div>

        </EditForm>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public Producto Producto { get; set; } = new();
    [Parameter] public EventCallback OnGuardado { get; set; }
    [Parameter] public EventCallback OnCerrar { get; set; }

    private List<Categoria> _categorias = new();
    private string? _imagenPreview;
    private bool _guardando = false;

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && _categorias.Count == 0)
        {
            _categorias = await Contexto.Categorias
                .OrderBy(c => c.Nombre)
                .ToListAsync();
        }

        if (Producto.Imagen != null && _imagenPreview == null)
        {
            _imagenPreview = $"data:image/jpeg;base64,{Convert.ToBase64String(Producto.Imagen)}";
        }
    }

    private async Task CargarImagen(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        const long maxBytes = 2 * 1024 * 1024;

        using var stream = archivo.OpenReadStream(maxBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);

        Producto.Imagen = ms.ToArray();
        _imagenPreview = $"data:image/{archivo.ContentType.Split('/')[1]};base64,{Convert.ToBase64String(Producto.Imagen)}";
    }

    private async Task Guardar()
    {
        _guardando = true;

        if (Producto.Id == 0)
            Contexto.Productos.Add(Producto);
        else
            Contexto.Productos.Update(Producto);

        await Contexto.SaveChangesAsync();
        _guardando = false;
        _imagenPreview = null;

        await OnGuardado.InvokeAsync();
    }

    private async Task Cerrar()
    {
        _imagenPreview = null;
        await OnCerrar.InvokeAsync();
    }
}