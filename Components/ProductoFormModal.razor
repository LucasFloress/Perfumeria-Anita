    @* Components/ProductoFormModal.razor *@
    @using PerfumeriaAnita.Models
    @using PerfumeriaAnita.Data
    @using PerfumeriaAnita.Services
    @using Microsoft.EntityFrameworkCore
    @inject AppDbContext Contexto
    @inject ISnackbar Snackbar
    @inject IConfigService ConfigService
   

    @if (Visible)
    {
        <div class="modal-backdrop" @onclick="Cerrar"></div>
        <div class="modal-box" @onclick:stopPropagation>

            <div class="modal-header">
                <h3>@(Producto.Id == 0 ? "➕ Nuevo Producto" : "✏️ Editar Producto")</h3>
                <button class="btn-cerrar" @onclick="Cerrar">✕</button>
            </div>

            <EditForm Model="Producto" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                <div class="form-grid">
                    @* Nombre *@
                    <div class="form-group full-width">
                        <label>Nombre *</label>
                        <InputText @bind-Value="Producto.Nombre" class="form-input" placeholder="Ej: Chanel N°5" />
                        <ValidationMessage For="@(() => Producto.Nombre)" />
                    </div>

                    @* Código de Barras *@
                    <div class="form-group">
                        <label>Código de Barras *</label>
                        <InputText @bind-Value="Producto.CodigoBarras" class="form-input" placeholder="Ej: 7791234567001" />
                        <ValidationMessage For="@(() => Producto.CodigoBarras)" />
                    </div>

                    @* Categoría *@
                    <div class="form-group">
                        <label>Categoría *</label>
                        <InputSelect @bind-Value="Producto.CategoriaId" class="form-input">
                            <option value="">-- Seleccionar --</option>
                            @foreach (var cat in _categorias)
                            {
                                <option value="@cat.Id">@cat.Nombre</option>
                            }
                        </InputSelect>
                    </div>

                    @* Precio y Stock *@
                    <div class="form-group">
                        <label>Precio de costo *</label>
                        <input type="number" 
                                step="0.01" 
                                class="form-input" 
                                @bind="_precioCosto" 
                                @bind:event="oninput" 
                                @bind:after="CalcularPrecios" />
                    </div>
                    <div class="form-group">
                        <label>Precio de venta *</label>
                        <InputNumber @bind-Value="Producto.Precio" class="form-input" />
                        <small style="color:#888; font-size:0.8rem;">Calculado con @_porcentajeAumento% (editable)</small>
                    </div>
                    <div class="form-group">
                        <label>Stock *</label>
                        <InputNumber @bind-Value="Producto.Stock" class="form-input" />
                    </div>
                    @* Activo *@
                    <div class="form-group checkbox-group">
                        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                            <input type="checkbox"
                                checked="@(Producto.Activo == true)"
                                @onchange="@(e => Producto.Activo = (bool)(e.Value ?? false))" />
                            Producto activo
                        </label>
                    </div>

                    @* Imagen *@
                    <div class="form-group full-width">
                        <label>Imagen (opcional)</label>
                        <InputFile OnChange="CargarImagen" accept="image/*" class="form-input" />
                        @if (_imagenPreview != null)
                        {
                            <img src="@_imagenPreview" alt="Preview" class="img-preview" />
                        }
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn-cancelar" @onclick="Cerrar">Cancelar</button>
                    <button type="submit" class="btn-guardar" disabled="@_guardando">
                        @(_guardando ? "Guardando..." : "Guardar")
                    </button>
                </div>
            </EditForm>
        </div>
    }

    @code {
        [Parameter] public bool Visible { get; set; }
        [Parameter] public Producto Producto { get; set; } = new();
        [Parameter] public EventCallback OnGuardado { get; set; }
        [Parameter] public EventCallback OnCerrar { get; set; }

        private List<Categoria> _categorias = new();
        private string? _imagenPreview;
        private bool _guardando = false;
        private decimal _porcentajeAumento = 30;
        private string _metodoPagoDefault = "Efectivo";
        private List<string> _metodosPago = new() { "Efectivo", "Tarjeta", "Transferencia" };
        private decimal _precioCosto;


        protected override async Task OnParametersSetAsync()
        {
            if (Visible && !_categorias.Any())
            {
                _categorias = await Contexto.Categorias.OrderBy(c => c.Nombre).ToListAsync();
            }

            if (Producto.Imagen != null)
                _imagenPreview = $"data:image/jpeg;base64,{Convert.ToBase64String(Producto.Imagen)}";

            // Cargar el porcentaje de configuraciones
            var porcentajeStr = await ConfigService.GetAsync(
                AppConfig.Keys.PorcentajeAumento, 
                "30"
            );  
            decimal.TryParse(porcentajeStr, out _porcentajeAumento);

            // Cargar el método de pago por defecto
            var metodoPagoStr = await ConfigService.GetAsync(
                AppConfig.Keys.MetodoPagoDefault,
                "Efectivo"
            );
            _metodoPagoDefault = metodoPagoStr ?? "Efectivo";

            if (Producto.Id != 0)
            {
                Producto.Precio = Producto.Precio;
            }
        }

        private async Task CargarImagen(InputFileChangeEventArgs e)
        {
            var archivo = e.File;
            using var stream = archivo.OpenReadStream(2 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            Producto.Imagen = ms.ToArray();
            _imagenPreview = $"data:image/png;base64,{Convert.ToBase64String(Producto.Imagen)}";
        }


        private void CalcularPrecios()
        {
            if (_precioCosto > 0)
            {
                // Calculamos el precio de venta en base al costo ingresado + el porcentaje
                Producto.Precio = _precioCosto * (1 + _porcentajeAumento / 100M);
            }
            else
            {
                Producto.Precio = 0;
            }
        }

        private async Task Guardar()
        {
            _guardando = true;
            try
            {
                // Validar nombre duplicado (ignorando el producto actual en caso de edición)
                var existeNombre = await Contexto.Productos.AnyAsync(p => 
                    p.Nombre.ToLower() == Producto.Nombre.ToLower() && p.Id != Producto.Id);
                if (existeNombre)
                {
                    Snackbar.Add("Ya existe un producto con este nombre.", Severity.Warning);
                    _guardando = false;
                    return;
                }

                // Validar código de barras duplicado
                if (!string.IsNullOrWhiteSpace(Producto.CodigoBarras))
                {
                    var existeCodigo = await Contexto.Productos.AnyAsync(p => 
                        p.CodigoBarras == Producto.CodigoBarras && p.Id != Producto.Id);
                    if (existeCodigo)
                    {
                        Snackbar.Add("Ya existe un producto con este código de barras.", Severity.Warning);
                        _guardando = false;
                        return;
                    }
                }

                if (Producto.Id == 0)
                {
                    // Es uno nuevo, lo agregamos normal
                    Contexto.Productos.Add(Producto);
                }
                else
                {
                    // Es una edición. Buscamos el objeto original que EF tiene en su memoria
                    var productoEnMemoria = await Contexto.Productos.FindAsync(Producto.Id);
                    
                    if (productoEnMemoria != null)
                    {
                        // EF copia automáticamente todos los cambios del "Clon" (Producto) al objeto original
                        Contexto.Entry(productoEnMemoria).CurrentValues.SetValues(Producto);
                        
                        // Asegurarnos de copiar la imagen también si se modificó
                        productoEnMemoria.Imagen = Producto.Imagen; 
                    }
                }

                await Contexto.SaveChangesAsync();
                Snackbar.Add("¡Guardado!", Severity.Success);
                await OnGuardado.InvokeAsync();
            }
            catch (Exception ex)
            {
                // Ahora si hay un error, lo verás clarito
                Snackbar.Add($"Error en BD: {ex.Message}", Severity.Error);
            }
            finally
            {
                _guardando = false;
            }
        }

        private async Task Cerrar() { _imagenPreview = null; await OnCerrar.InvokeAsync(); }
    }