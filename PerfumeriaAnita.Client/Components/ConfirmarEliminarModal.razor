@if (Visible)
{
    <div class="modal-backdrop" @onclick="Cancelar"></div>
    <div class="modal-box modal-pequeno" @onclick:stopPropagation>
        <div class="modal-header">
            <h3>🗑️ Confirmar eliminación</h3>
        </div>
        <p class="modal-mensaje">
            ¿Estás seguro que querés eliminar <strong>@NombreProducto</strong>?
            Esta acción no se puede deshacer.
        </p>
        <div class="modal-footer">
            <button class="btn-cancelar" @onclick="Cancelar">Cancelar</button>
            <button class="btn-eliminar" @onclick="Confirmar">Sí, eliminar</button>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string NombreProducto { get; set; } = "";
    [Parameter] public EventCallback OnConfirmar { get; set; }
    [Parameter] public EventCallback OnCancelar { get; set; }

    private async Task Confirmar() => await OnConfirmar.InvokeAsync();
    private async Task Cancelar() => await OnCancelar.InvokeAsync();
}
