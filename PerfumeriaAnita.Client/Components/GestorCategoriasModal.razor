@using PerfumeriaAnita.Client.Services
@inject ICategoriaService CategoriaService
@inject IConfigService ConfigService
@inject ISnackbar Snackbar

@if (EstaAbierto)
{
    <style>
        .cat-modal-panel { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); width: min(90vw, 550px); background: #fff; border-radius: 16px; box-shadow: 0 24px 60px rgba(0,0,0,0.15); z-index: 1001; animation: slideUp 0.2s ease-out; display: flex; flex-direction: column; overflow: hidden; }
        .cat-header { display: flex; justify-content: space-between; align-items: center; padding: 20px 25px; border-bottom: 1px solid #f1f5f9; background: #fafbfc; }
        .cat-header h2 { margin: 0; font-size: 1.25rem; font-weight: 800; color: #0f172a; display: flex; align-items: center; gap: 8px; }
        .cat-close { background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #94a3b8; transition: color 0.2s; }
        .cat-close:hover { color: #e91e63; }
        .cat-body { padding: 25px; }
        .cat-form { display: flex; gap: 10px; margin-bottom: 25px; background: #f8fafc; padding: 15px; border-radius: 12px; border: 1px solid #e2e8f0; }
        .cat-input { flex: 1; padding: 10px 15px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.95rem; outline: none; transition: border-color 0.2s; }
        .cat-input:focus { border-color: @_colorPrincipal; box-shadow: 0 0 0 3px rgba(0,0,0,0.05); }
        .cat-btn-save { padding: 10px 20px; border: none; border-radius: 8px; color: white; font-weight: bold; cursor: pointer; transition: opacity 0.2s; }
        .cat-btn-save:hover { opacity: 0.9; }
        .cat-table-wrapper { max-height: 350px; overflow-y: auto; border: 1px solid #e2e8f0; border-radius: 12px; }
        .cat-table { width: 100%; border-collapse: collapse; text-align: left; }
        .cat-table th { padding: 12px 15px; background: #f8fafc; color: #64748b; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; position: sticky; top: 0; z-index: 1; }
        .cat-table td { padding: 12px 15px; border-top: 1px solid #f1f5f9; vertical-align: middle; }
        .cat-badge { background: #f1f5f9; color: #475569; padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; display: inline-block; }
        .cat-acciones { display: flex; gap: 5px; }
        .cat-btn-icon { background: none; border: none; cursor: pointer; padding: 6px; border-radius: 6px; color: #64748b; transition: all 0.2s; display: flex; align-items: center; justify-content: center; }
        .cat-btn-icon:hover { background: #f1f5f9; color: #0f172a; }
        .cat-btn-icon.delete:hover { background: #fee2e2; color: #ef4444; }
    </style>

    <div class="modal-backdrop" @onclick="CerrarModal" style="z-index: 1000;"></div>
    <div class="cat-modal-panel">
        <div class="cat-header">
            <h2><span class="material-symbols-outlined" style="color: @_colorPrincipal;">category</span> Gestión de Categorías</h2>
            <button class="cat-close" @onclick="CerrarModal">✕</button>
        </div>
        <div class="cat-body">
            <div class="cat-form">
                <input type="text" class="cat-input" placeholder="Nombre de la categoría..." @bind="_categoriaActual.Nombre" @bind:event="oninput" />
                @if (_categoriaActual.Id != 0)
                {
                    <button class="cat-btn-icon" @onclick="CancelarEdicion" title="Cancelar edición">✕</button>
                }
                <button class="cat-btn-save" style="background: @_colorPrincipal;" @onclick="Guardar" disabled="@string.IsNullOrWhiteSpace(_categoriaActual.Nombre)">
                    @(_categoriaActual.Id == 0 ? "Agregar" : "Actualizar")
                </button>
            </div>
            <div class="cat-table-wrapper">
                <table class="cat-table">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Uso</th>
                            <th style="width: 80px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!_categorias.Any())
                        {
                            <tr><td colspan="3" style="text-align: center; color: #94a3b8; padding: 20px;">No hay categorías creadas.</td></tr>
                        }
                        @foreach (var cat in _categorias)
                        {
                            <tr>
                                <td style="font-weight: 500; color: #1e293b;">@cat.Nombre</td>
                                <td><span class="cat-badge">@cat.ProductosCount productos</span></td>
                                <td>
                                    <div class="cat-acciones">
                                        <button class="cat-btn-icon" @onclick="() => Editar(cat)" title="Editar"><span class="material-symbols-outlined" style="font-size: 1.1rem;">edit</span></button>
                                        <button class="cat-btn-icon delete" @onclick="() => Eliminar(cat.Id)" title="Eliminar"><span class="material-symbols-outlined" style="font-size: 1.1rem;">delete</span></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnCambioCategorias { get; set; }

    private bool EstaAbierto = false;
    private string _colorPrincipal = "#e91e63";
    private List<CategoriaDto> _categorias = new();
    private CategoriaDto _categoriaActual = new() { Activo = true };

    public async Task AbrirModal()
    {
        EstaAbierto = true;
        CancelarEdicion();
        await CargarCategorias();
        StateHasChanged();
    }

    private void CerrarModal() { EstaAbierto = false; }

    private async Task CargarCategorias()
    {
        try { _categorias = await CategoriaService.GetAllAsync(); } catch { }
    }

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(_categoriaActual.Nombre)) return;
        try
        {
            if (_categoriaActual.Id == 0)
            {
                var result = await CategoriaService.CreateAsync(_categoriaActual);
                if (result == null) { Snackbar.Add("Error: ya existe una categoría con ese nombre.", Severity.Warning); return; }
            }
            else
            {
                var exito = await CategoriaService.UpdateAsync(_categoriaActual.Id, _categoriaActual);
                if (!exito) { Snackbar.Add("Error al actualizar.", Severity.Error); return; }
            }

            Snackbar.Add($"Categoría {(_categoriaActual.Id == 0 ? "creada" : "actualizada")} con éxito", Severity.Success);
            CancelarEdicion();
            await CargarCategorias();
            await OnCambioCategorias.InvokeAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void Editar(CategoriaDto cat)
    {
        _categoriaActual = new CategoriaDto
        {
            Id = cat.Id,
            Nombre = cat.Nombre,
            Descripcion = cat.Descripcion,
            Activo = cat.Activo
        };
    }

    private void CancelarEdicion() { _categoriaActual = new CategoriaDto { Activo = true }; }

    private async Task Eliminar(int id)
    {
        var (exito, mensaje) = await CategoriaService.DeleteAsync(id);
        Snackbar.Add(mensaje, exito ? Severity.Success : Severity.Warning);
        if (exito)
        {
            await CargarCategorias();
            await OnCambioCategorias.InvokeAsync();
        }
    }
}
