@using PerfumeriaAnita.Client.Services
@inject AppConfigState ConfigState
@implements IDisposable

<aside class="sidebar" style="--color-principal: @ConfigState.ColorPrincipal">
    <div class="logo">
        @if (!string.IsNullOrEmpty(ConfigState.LogoBase64))
        {
            <img src="@ConfigState.LogoBase64" alt="Logo @ConfigState.NombreTienda" class="logo-img" />
        }
        else
        {
            <span class="logo-emoji">🌸</span>
        }
        <div class="logo-texto">
            <span class="logo-nombre">@ConfigState.NombreTienda</span>
            @if (!string.IsNullOrWhiteSpace(ConfigState.Eslogan))
            {
                <span class="logo-eslogan">@ConfigState.Eslogan</span>
            }
        </div>
    </div>
    <nav class="nav-menu">
        <a href="/dashboard" class="nav-item">Panel Principal</a>
        <a href="/inventario" class="nav-item">Inventario</a>
        <a href="/ventas" class="nav-item">Ventas</a>
        <a href="/configuraciones" class="nav-item">Configuración</a>
    </nav>
</aside>

@code {
    protected override void OnInitialized()
    {
        ConfigState.OnChange += OnConfigChanged;
    }

    private void OnConfigChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ConfigState.OnChange -= OnConfigChanged;
    }
}
